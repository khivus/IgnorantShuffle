#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "windows_version.h"
IDD_SETTINGS DIALOGEX 0, 0, 480, 430
STYLE DS_SETFONT | DS_CONTROL | WS_POPUP | WS_CLIPCHILDREN
CAPTION "IgnorantShuffle"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Click a column header to sort. Ctrl/Shift-click to select tracks; hover a weight for full details. Weights save in each track's music root.", -1, 10, 6, 366, 20
    PUSHBUTTON "Select all", IDC_SELECT_ALL, 386, 7, 84, 15
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 30, 460, 300
    PUSHBUTTON "0", 1300, 10, 336, 38, 15, WS_GROUP
    PUSHBUTTON "1", 1301, 52, 336, 38, 15
    PUSHBUTTON "2", 1302, 94, 336, 38, 15
    PUSHBUTTON "3", 1303, 136, 336, 38, 15
    PUSHBUTTON "4", 1304, 178, 336, 38, 15
    PUSHBUTTON "5", 1305, 220, 336, 38, 15
    PUSHBUTTON "6", 1306, 262, 336, 38, 15
    PUSHBUTTON "7", 1307, 304, 336, 38, 15
    PUSHBUTTON "8", 1308, 346, 336, 38, 15
    PUSHBUTTON "9", 1309, 388, 336, 38, 15
    PUSHBUTTON "10", 1310, 430, 336, 38, 15
    LTEXT "Custom weight:", -1, 10, 361, 70, 10
    EDITTEXT IDC_WEIGHT, 83, 358, 75, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Apply custom", IDC_APPLY_WEIGHT, 166, 357, 91, 16
    PUSHBUTTON "Refresh playlist", IDC_REFRESH, 279, 357, 101, 16
    LTEXT "", IDC_STATUS, 10, 379, 460, 20
    PUSHBUTTON "Music folders and rules", IDC_STORAGE, 10, 406, 90, 18
    PUSHBUTTON "Use default", IDC_RESET_WEIGHT, 110, 406, 78, 18
    DEFPUSHBUTTON "Close", IDOK, 392, 406, 78, 18
END
IDD_STORAGE DIALOGEX 0, 0, 350, 342
STYLE DS_SETFONT | DS_CONTROL | WS_POPUP | WS_CLIPCHILDREN
CAPTION "IgnorantShuffle - Weight storage"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Weights are saved only in IgnorantShuffle.weights.tsv in each music root. For D:\\Music\\Artist\\Song.flac, add D:\\Music.", -1, 10, 8, 330, 24
    LTEXT "Music roots (one folder per line; separate libraries use separate files):", -1, 10, 36, 330, 12
    EDITTEXT IDC_MUSIC_FOLDER, 10, 52, 264, 42, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add...", IDC_BROWSE_MUSIC, 282, 52, 58, 16
    PUSHBUTTON "Apply / reload", IDC_APPLY_STORAGE, 10, 102, 94, 16
    EDITTEXT IDC_STORAGE_STATUS, 10, 126, 330, 40, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Import/export music root:", -1, 10, 174, 330, 12
    COMBOBOX IDC_TRANSFER_ROOT, 10, 190, 330, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Import...", IDC_IMPORT, 10, 210, 76, 16
    PUSHBUTTON "Export...", IDC_EXPORT, 94, 210, 76, 16
    LTEXT "Import replaces this root's file. Export copies it unchanged. Sync the file together with its music subfolders to share weights with Android.", -1, 10, 232, 330, 22
    CONTROL "Share settings between devices (off by default)", IDC_SHARE_SETTINGS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 264, 330, 16
    LTEXT "Shares shuffle rules and learning options using the first music root. Sync IgnorantShuffle.settings.tsv with your music. Device preferences stay local.", -1, 10, 285, 330, 24
    PUSHBUTTON "Reload shared", IDC_RELOAD_SETTINGS, 10, 316, 115, 18
    PUSHBUTTON "Publish current settings", IDC_PUBLISH_SETTINGS, 136, 316, 160, 18
END
IDD_MONITOR DIALOGEX 0, 0, 260, 230
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_VSCROLL
EXSTYLE WS_EX_APPWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT
CAPTION "IgnorantShuffle"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Weighted shuffle enabled", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 10, 176, 14
    CONTROL "Always on top", IDC_PINNED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 10, 90, 14
    CONTROL "Attach to AIMP", IDC_ATTACHED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 27, 180, 14
    CONTROL "Play playlist once", IDC_FINITE_PLAYLIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 43, 110, 12
    LTEXT "Waiting for AIMP...", IDC_MODE, 10, 31, 290, 24, SS_NOPREFIX
    GROUPBOX "Current track", IDC_CURRENT_GROUP, 10, 58, 290, 83
    LTEXT "Nothing playing", IDC_CURRENT_TRACK, 18, 72, 274, 24, SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT "Current weight: -", IDC_CURRENT_WEIGHT, 18, 99, 198, 12, SS_NOPREFIX
    CONTROL "0 - Exclude", IDC_QUICK_WEIGHT_0, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP | WS_GROUP, 222, 96, 70, 17
    CONTROL "1", IDC_QUICK_WEIGHT_1, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 18, 117, 24, 17
    CONTROL "2", IDC_QUICK_WEIGHT_2, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 45, 117, 24, 17
    CONTROL "3", IDC_QUICK_WEIGHT_3, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 72, 117, 24, 17
    CONTROL "4", IDC_QUICK_WEIGHT_4, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 99, 117, 24, 17
    CONTROL "5", IDC_QUICK_WEIGHT_5, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 126, 117, 24, 17
    CONTROL "6", IDC_QUICK_WEIGHT_6, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 153, 117, 24, 17
    CONTROL "7", IDC_QUICK_WEIGHT_7, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 180, 117, 24, 17
    CONTROL "8", IDC_QUICK_WEIGHT_8, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 207, 117, 24, 17
    CONTROL "9", IDC_QUICK_WEIGHT_9, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 234, 117, 24, 17
    CONTROL "10", IDC_QUICK_WEIGHT_10, "Button", BS_CHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 261, 117, 24, 17
    LTEXT "Cooldown (tracks):", IDC_COOLDOWN_LABEL, 10, 151, 85, 12
    EDITTEXT IDC_COOLDOWN, 98, 148, 48, 17, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON "Apply", IDC_APPLY_COOLDOWN, 154, 148, 45, 18
    LTEXT "0 = off", IDC_COOLDOWN_OFF, 209, 151, 90, 12
    LTEXT "Cooldown off", IDC_COOLDOWN_STATUS, 10, 172, 290, 24, SS_NOPREFIX
    GROUPBOX "Next weighted choice", IDC_NEXT_GROUP, 10, 202, 290, 103
    LTEXT "Waiting for AIMP to request a track", IDC_NEXT_TRACK, 18, 216, 274, 24, SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT "", IDC_DECISION, 18, 244, 274, 55, SS_NOPREFIX
    PUSHBUTTON "Settings...", IDC_EDIT_WEIGHTS, 10, 313, 88, 18, WS_GROUP
    PUSHBUTTON "Reroll next", IDC_REROLL_NEXT, 106, 313, 116, 18
    PUSHBUTTON "Open logs", IDC_OPEN_LOGS, 230, 313, 70, 18
    LTEXT "AIMP's manual queue and repeat settings can take priority.", IDC_PANEL_NOTICE, 10, 339, 290, 20, SS_NOPREFIX
    PUSHBUTTON "Statistics / learning...", IDC_STATISTICS, 10, 364, 100, 15
    PUSHBUTTON "Updates...", IDC_UPDATES, 10, 364, 65, 15
    LTEXT "", IDC_UPDATE_SUMMARY, 80, 364, 210, 20, SS_NOPREFIX
END
IDD_UPDATES DIALOGEX 0, 0, 350, 202
STYLE DS_SETFONT | DS_CONTROL | WS_POPUP | WS_CLIPCHILDREN
CAPTION "IgnorantShuffle - Updates"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_UPDATE_VERSION, 10, 8, 330, 12
    CONTROL "Automatically check for updates (daily)", IDC_UPDATE_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 26, 330, 12
    LTEXT "GitHub repository (owner/repository or release-page URL):", -1, 10, 46, 330, 10
    EDITTEXT IDC_UPDATE_REPOSITORY, 10, 59, 330, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Save source", IDC_UPDATE_SAVE, 10, 80, 78, 16
    PUSHBUTTON "Check now", IDC_UPDATE_CHECK, 96, 80, 78, 16
    PUSHBUTTON "View release", IDC_UPDATE_RELEASE, 182, 80, 78, 16
    EDITTEXT IDC_UPDATE_STATUS, 10, 104, 330, 36, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Installation opens AIMP's package installer. Finish installation and restart when AIMP asks.", -1, 10, 146, 330, 20
    PUSHBUTTON "Download and install", IDC_UPDATE_INSTALL, 10, 177, 130, 17
    PUSHBUTTON "Open package folder", IDC_UPDATE_FOLDER, 146, 177, 120, 17
    DEFPUSHBUTTON "Close", IDOK, 274, 177, 66, 17
END
1 VERSIONINFO
 FILEVERSION IGNORANT_SHUFFLE_WINDOWS_VERSION_RC
 PRODUCTVERSION IGNORANT_SHUFFLE_WINDOWS_VERSION_RC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Ignorant Shuffle weighted shuffle for AIMP"
   VALUE "FileVersion", IGNORANT_SHUFFLE_WINDOWS_VERSION
   VALUE "ProductVersion", IGNORANT_SHUFFLE_WINDOWS_VERSION
   VALUE "ProductName", "Ignorant Shuffle"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END

IDD_RULES DIALOGEX 0, 0, 350, 300
STYLE DS_SETFONT | DS_CONTROL | WS_POPUP | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Default weight", -1, 12, 12, 150, 12
    EDITTEXT IDC_DEFAULT_WEIGHT, 12, 30, 90, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Apply default", IDC_APPLY_DEFAULT_WEIGHT, 112, 30, 100, 16
    LTEXT "Used for tracks without a saved weight. Initially 5.", -1, 12, 54, 320, 20
    LTEXT "Minimum eligible weight", -1, 12, 85, 240, 12
    EDITTEXT IDC_MINIMUM_WEIGHT, 12, 103, 90, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Apply minimum", IDC_APPLY_MINIMUM_WEIGHT, 112, 103, 100, 16
    LTEXT "Must be greater than zero. Lower weights are excluded.", -1, 12, 127, 320, 20
    LTEXT "Cooldown (other tracks before a repeat; 0 = off)", -1, 12, 158, 320, 12
    EDITTEXT IDC_COOLDOWN, 12, 176, 90, 16, ES_NUMBER | WS_TABSTOP
    PUSHBUTTON "Apply cooldown", IDC_APPLY_COOLDOWN, 112, 176, 100, 16
    CONTROL "Play playlist once", IDC_FINITE_PLAYLIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 214, 250, 16
    LTEXT "", IDC_STORAGE_STATUS, 12, 250, 320, 40
END
