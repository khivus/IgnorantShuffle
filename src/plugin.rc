#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDD_SETTINGS DIALOGEX 0, 0, 480, 288
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IgnorantShuffle"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Click a column header to sort. Ctrl/Shift-click to select tracks; hover a weight for full details. Edit shows the selected scope's value.", -1, 10, 6, 366, 20
    PUSHBUTTON "Select all", IDC_SELECT_ALL, 386, 7, 84, 15
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 30, 460, 158
    PUSHBUTTON "0", 1300, 10, 194, 38, 15, WS_GROUP
    PUSHBUTTON "1", 1301, 52, 194, 38, 15
    PUSHBUTTON "2", 1302, 94, 194, 38, 15
    PUSHBUTTON "3", 1303, 136, 194, 38, 15
    PUSHBUTTON "4", 1304, 178, 194, 38, 15
    PUSHBUTTON "5", 1305, 220, 194, 38, 15
    PUSHBUTTON "6", 1306, 262, 194, 38, 15
    PUSHBUTTON "7", 1307, 304, 194, 38, 15
    PUSHBUTTON "8", 1308, 346, 194, 38, 15
    PUSHBUTTON "9", 1309, 388, 194, 38, 15
    PUSHBUTTON "10", 1310, 430, 194, 38, 15
    LTEXT "Custom weight:", -1, 10, 219, 70, 10
    EDITTEXT IDC_WEIGHT, 83, 216, 75, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Apply custom", IDC_APPLY_WEIGHT, 166, 215, 91, 16
    PUSHBUTTON "Refresh playlist", IDC_REFRESH, 279, 215, 101, 16
    LTEXT "", IDC_STATUS, 10, 237, 460, 20
    PUSHBUTTON "Weight storage...", IDC_STORAGE, 10, 264, 90, 18
    COMBOBOX IDC_WEIGHT_SCOPE, 110, 264, 120, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Inherit", IDC_RESET_LOCAL, 240, 264, 66, 18
    DEFPUSHBUTTON "Close", IDOK, 392, 264, 78, 18
END
IDD_STORAGE DIALOGEX 0, 0, 350, 268
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IgnorantShuffle - Weight storage"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Optional shared files use relative track paths. With all options off, weights stay in AIMP's profile as before.", -1, 10, 8, 330, 16
    LTEXT "Music folder:", -1, 10, 30, 330, 10
    EDITTEXT IDC_MUSIC_FOLDER, 10, 42, 264, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Browse...", IDC_BROWSE_MUSIC, 282, 42, 58, 14
    CONTROL "Use shared global weights in the music folder", IDC_SHARED_GLOBAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 64, 330, 12
    CONTROL "Use folder-local weight overrides", IDC_FOLDER_LOCAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 80, 330, 12
    CONTROL "Use AIMP-playlist-specific weight overrides", IDC_PLAYLIST_LOCAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 96, 330, 12
    LTEXT "Folder context is the common music folder of the current list. A broader list uses its broader folder context. AIMP-playlist overrides also use the playlist name.", -1, 10, 116, 330, 28
    PUSHBUTTON "Apply / reload", IDC_APPLY_STORAGE, 10, 150, 94, 16
    PUSHBUTTON "Copy missing profile weights", IDC_COPY_PROFILE, 112, 150, 150, 16
    EDITTEXT IDC_STORAGE_STATUS, 10, 174, 330, 38, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Import/export:", -1, 10, 221, 70, 10
    COMBOBOX IDC_WEIGHT_SCOPE, 84, 218, 88, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Import...", IDC_IMPORT, 180, 218, 64, 16
    PUSHBUTTON "Export...", IDC_EXPORT, 252, 218, 64, 16
    DEFPUSHBUTTON "Close", IDOK, 274, 244, 66, 16
END
IDD_MONITOR DIALOGEX 0, 0, 260, 230
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_VSCROLL
EXSTYLE WS_EX_APPWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT
CAPTION "IgnorantShuffle"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "Weighted shuffle enabled", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 10, 176, 14
    CONTROL "Always on top", IDC_PINNED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 10, 90, 14
    CONTROL "Attach to AIMP", IDC_ATTACHED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 110, 27, 180, 14
    CONTROL "Play playlist once", IDC_FINITE_PLAYLIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 43, 110, 12
    LTEXT "Waiting for AIMP...", IDC_MODE, 10, 31, 290, 24, SS_NOPREFIX
    GROUPBOX "Current track", IDC_CURRENT_GROUP, 10, 58, 290, 83
    LTEXT "Nothing playing", IDC_CURRENT_TRACK, 18, 72, 274, 24, SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT "Current weight: -", IDC_CURRENT_WEIGHT, 18, 99, 198, 12, SS_NOPREFIX
    CONTROL "0 - Exclude", IDC_QUICK_WEIGHT_0, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP | WS_GROUP, 222, 96, 70, 17
    CONTROL "1", IDC_QUICK_WEIGHT_1, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 18, 117, 24, 17
    CONTROL "2", IDC_QUICK_WEIGHT_2, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 45, 117, 24, 17
    CONTROL "3", IDC_QUICK_WEIGHT_3, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 72, 117, 24, 17
    CONTROL "4", IDC_QUICK_WEIGHT_4, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 99, 117, 24, 17
    CONTROL "5", IDC_QUICK_WEIGHT_5, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 126, 117, 24, 17
    CONTROL "6", IDC_QUICK_WEIGHT_6, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 153, 117, 24, 17
    CONTROL "7", IDC_QUICK_WEIGHT_7, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 180, 117, 24, 17
    CONTROL "8", IDC_QUICK_WEIGHT_8, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 207, 117, 24, 17
    CONTROL "9", IDC_QUICK_WEIGHT_9, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 234, 117, 24, 17
    CONTROL "10", IDC_QUICK_WEIGHT_10, "Button", BS_RADIOBUTTON | BS_PUSHLIKE | WS_TABSTOP, 261, 117, 24, 17
    LTEXT "Edit:", IDC_SCOPE_LABEL, 18, 138, 20, 12
    COMBOBOX IDC_WEIGHT_SCOPE, 42, 138, 95, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Inherit", IDC_RESET_LOCAL, 145, 138, 48, 15
    LTEXT "Cooldown (tracks):", IDC_COOLDOWN_LABEL, 10, 151, 85, 12
    EDITTEXT IDC_COOLDOWN, 98, 148, 48, 17, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON "Apply", IDC_APPLY_COOLDOWN, 154, 148, 45, 18
    LTEXT "0 = off", IDC_COOLDOWN_OFF, 209, 151, 90, 12
    LTEXT "Cooldown off", IDC_COOLDOWN_STATUS, 10, 172, 290, 24, SS_NOPREFIX
    GROUPBOX "Next weighted choice", IDC_NEXT_GROUP, 10, 202, 290, 103
    LTEXT "Waiting for AIMP to request a track", IDC_NEXT_TRACK, 18, 216, 274, 24, SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT "", IDC_DECISION, 18, 244, 274, 55, SS_NOPREFIX
    PUSHBUTTON "Track weights...", IDC_EDIT_WEIGHTS, 10, 313, 88, 18, WS_GROUP
    PUSHBUTTON "Reroll next", IDC_REROLL_NEXT, 106, 313, 116, 18
    PUSHBUTTON "Open logs", IDC_OPEN_LOGS, 230, 313, 70, 18
    LTEXT "AIMP's manual queue and repeat settings can take priority.", IDC_PANEL_NOTICE, 10, 339, 290, 20, SS_NOPREFIX
    PUSHBUTTON "Updates...", IDC_UPDATES, 10, 364, 65, 15
    LTEXT "", IDC_UPDATE_SUMMARY, 80, 364, 210, 20, SS_NOPREFIX
END
IDD_UPDATES DIALOGEX 0, 0, 350, 202
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IgnorantShuffle - Updates"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_UPDATE_VERSION, 10, 8, 330, 12
    CONTROL "Automatically check for updates (daily)", IDC_UPDATE_AUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 26, 330, 12
    LTEXT "GitHub repository (owner/repository or release-page URL):", -1, 10, 46, 330, 10
    EDITTEXT IDC_UPDATE_REPOSITORY, 10, 59, 330, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Save source", IDC_UPDATE_SAVE, 10, 80, 78, 16
    PUSHBUTTON "Check now", IDC_UPDATE_CHECK, 96, 80, 78, 16
    PUSHBUTTON "View release", IDC_UPDATE_RELEASE, 182, 80, 78, 16
    EDITTEXT IDC_UPDATE_STATUS, 10, 104, 330, 36, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Installation opens AIMP's package installer. Finish installation and restart when AIMP asks.", -1, 10, 146, 330, 20
    PUSHBUTTON "Download and install", IDC_UPDATE_INSTALL, 10, 177, 130, 17
    PUSHBUTTON "Open package folder", IDC_UPDATE_FOLDER, 146, 177, 120, 17
    DEFPUSHBUTTON "Close", IDOK, 274, 177, 66, 17
END
1 VERSIONINFO
 FILEVERSION 0,10,1,0
 PRODUCTVERSION 0,10,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "IgnorantShuffle weighted shuffle for AIMP"
   VALUE "FileVersion", "0.10.1"
   VALUE "ProductName", "IgnorantShuffle"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
