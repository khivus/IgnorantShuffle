# Read only the component requested by the caller. Version edits trigger reconfigure.
function(read_component_version component output)
  set(path "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../versions/${component}.properties")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  file(STRINGS "${path}" entries REGEX "^version=")
  list(LENGTH entries count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one version in ${path}")
  endif()
  string(REPLACE "version=" "" version "${entries}")
  if(NOT version MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid stable MAJOR.MINOR.PATCH version in ${path}")
  endif()
  set(${output} "${version}" PARENT_SCOPE)
endfunction()

function(configure_core_version directory)
  read_component_version(core IGNORANT_SHUFFLE_CORE_VERSION)
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/core_version.h.in" "${directory}/core_version.h" @ONLY)
endfunction()
